# Copy to .ii-local/models.env. Replace the sample IDs and full POST URLs with your internal routes.
II_MODEL_PROFILE=local
II_MINILM_HOST_DIR=/srv/iikuznica/models/minilm
II_LOCAL_GEMMA_URL=https://gemma.models.example.internal/v1/chat/completions
II_LOCAL_GEMMA_MODEL=google/gemma-4-26b-a4b-it
II_LOCAL_GEMMA_TOKEN=
II_LOCAL_QWEN_URL=https://qwen.models.example.internal/v1/chat/completions
II_LOCAL_QWEN_MODEL=qwen/qwen3.5-122b-a10b
II_LOCAL_QWEN_TOKEN=
II_LOCAL_DECIDER_URL=https://decider.models.example.internal/v1/decisions
II_LOCAL_DECIDER_MODEL=perplexity/pplx-decider-flash-v1.3
II_LOCAL_DECIDER_TOKEN=
# Optional: container path to your trusted CA bundle, placed in II_MINILM_HOST_DIR.
# II_LOCAL_CA_FILE=/models/pilot-ca.pem
