# GPU host, Linux/amd64. Replace these example placements with the host allocation.
II_WEIGHTS_DIR=/srv/ii-weights
II_MODEL_BIND_IP=127.0.0.1
II_GEMMA_GPUS=0
II_QWEN_GPUS=0
II_DECIDER_GPUS=0
II_QWEN_TP=1
II_QWEN_GPU_MEMORY_FRACTION=0.72
II_GEMMA_CONTEXT=16384
II_QWEN_CONTEXT=16384

# Use the repo names in your mirror. The two source image digests are locked in compose.yaml.
II_LLAMA_IMAGE_REPOSITORY=ghcr.io/ggml-org/llama.cpp
II_VLLM_IMAGE_REPOSITORY=vllm/vllm-openai
II_HAPROXY_IMAGE_REPOSITORY=haproxy
II_DECIDER_IMAGE_REPOSITORY=
II_DECIDER_IMAGE_SHA256=

# Supply the same three private credentials in the application profile.
II_GEMMA_API_KEY=
II_QWEN_API_KEY=
II_DECIDER_API_KEY=
